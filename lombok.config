# Don't look for further config files above this directory.
config.stopBubbling = true

# Marks every Lombok-generated method with @lombok.Generated, which JaCoCo
# skips automatically. Without this, coverage counts generated getters,
# setters, equals, hashCode, toString and builder internals as production
# code needing tests - which both depresses the percentage and buries the
# genuine gaps under noise nobody should be writing tests for.
#
# Concretely: Task and TaskDto contribute roughly 30 generated methods
# between them, several of which (TaskDto.setId, Task.setVersion,
# TaskDto.toString) no code path can reach.
lombok.addLombokGeneratedAnnotation = true
