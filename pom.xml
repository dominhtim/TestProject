<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.example</groupId>
    <artifactId>my-spring-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>my-spring-app</name>
    <description>Spring Boot 4.1 CRUD Demo with JDK 25 (LTS)</description>

    <properties>
        <java.version>25</java.version>
        <lombok.version>1.18.46</lombok.version>
        <failsafe-surefire.version>3.5.6</failsafe-surefire.version>
        <!-- Third-party, not covered by Spring Boot's dependency management. -->
        <springdoc.version>3.1.0</springdoc.version>
        <jacoco.version>0.8.15</jacoco.version>
        <sonar-maven-plugin.version>5.7.0.6970</sonar-maven-plugin.version>
        <!-- Both reports are needed: much of this app's coverage comes from
             the integration tests exercising the full HTTP stack, so omitting
             jacoco-it would understate it. -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml,${project.build.directory}/site/jacoco-it/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Mirrors the JaCoCo <excludes> below for the same class. -->
        <sonar.coverage.exclusions>**/MySpringAppApplication.java</sonar.coverage.exclusions>

        <!-- Security: jackson-databind CVEs (Dependabot #84/#86/#87/#88,
             GHSA-5jmj-h7xm-6q6v). Do not pin jackson-databind on its own: it
             needs a matching jackson-core and still borrows
             jackson-annotations from the 2.x line, and pinning it alone left
             annotations mismatched and broke serialization at runtime
             (NoClassDefFoundError: JsonApplyView). The BOM import below keeps
             the whole Jackson 3 stack consistent. -->
        <jackson2-databind.version>2.22.2</jackson2-databind.version>
        <jackson3-bom.version>3.2.1</jackson3-bom.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson3-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot 4 modularized spring-boot-starter-web into
             technology-specific starters; for servlet/Spring MVC it's
             spring-boot-starter-webmvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot 4 no longer bundles JSON support with
             spring-boot-starter-webmvc; without this the app can't
             (de)serialize JSON. Auto-configures a Jackson 3 JsonMapper. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!-- H2 web console auto-configuration, split out of the raw h2
             dependency in Boot 4. There is no "spring-boot-starter-h2-console"
             wrapper despite some pre-release docs referencing one; without
             this module spring.h2.console.enabled has no effect. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===================== Observability ===================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Explicit health module: defence-in-depth per the advisory for
             CVE-2026-40976 (actuator filter chain bypass), even though 4.1.0
             is already patched. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-health</artifactId>
        </dependency>

        <!-- Enough on the classpath to auto-configure /actuator/prometheus. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Boot 4.1's spring-boot-starter-opentelemetry isn't on a final
             4.1.0 release, so its constituent modules are declared directly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-micrometer-metrics</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- ===================== API Documentation ===================== -->

        <!-- springdoc 3.0.3 still generates its OpenAPI spec using Jackson 2
             internally even under Boot 4/Jackson 3 (tracked upstream:
             springdoc/springdoc-openapi#3268), which is why jackson-databind
             below is on the main classpath, not just test. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Spring Boot 4 ships a dedicated *-test starter per production
             starter; each brings spring-boot-starter-test (JUnit 5, Mockito,
             AssertJ, Jackson...) transitively. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.junit.vintage</groupId>
                    <artifactId>junit-vintage-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Jackson 2, which Boot 4 does not auto-configure (its mapper is
             Jackson 3's JsonMapper). On the main classpath because springdoc
             above needs it at runtime; the unit tests use it too. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson2-databind.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- <release>, not <source>/<target>: those still compile
                         against the running JDK's class library, so a newer
                         build JDK than runtime yields NoSuchMethodError in
                         production rather than a build failure. The Dockerfile
                         built with JDK 26 for a JRE 25 runtime. -->
                    <release>${java.version}</release>
                    <!-- springdoc-openapi needs parameter names in bytecode
                         to resolve them in the generated API docs. -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Unit tests (*Test.java) run in the default `test` phase. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${failsafe-surefire.version}</version>
            </plugin>

            <!-- Integration tests (*IT.java) run during `mvn verify`, after
                 packaging, keeping `mvn test` fast. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe-surefire.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Instruments both suites; reports feed Sonar via
                 sonar.coverage.jacoco.xmlReportPaths above. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!-- main() is one SpringApplication.run() call, and every
                         @SpringBootTest already proves the wiring works. -->
                    <excludes>
                        <exclude>**/MySpringAppApplication.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>prepare-agent-integration</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                            <goal>report-integration</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Unbound - invoked explicitly via `mvn sonar:sonar` in CI after
                 `verify`. Key/org/token are passed as -D flags, not hardcoded. -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar-maven-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
